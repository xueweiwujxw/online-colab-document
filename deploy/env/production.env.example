# Immutable application images built and pushed by CI/release tooling.
BACKEND_IMAGE=registry.example.com/online-colab-document/backend:VERSION
FRONTEND_IMAGE=registry.example.com/online-colab-document/frontend:VERSION
CASUAL_SHEETS_IMAGE=registry.example.com/online-colab-document/casual-sheets:VERSION
CASUAL_DOCS_IMAGE=registry.example.com/online-colab-document/casual-docs:VERSION

POSTGRES_DB=docs
POSTGRES_USER=docs
POSTGRES_PASSWORD=replace-with-a-strong-password
S3_ACCESS_KEY=replace-with-a-rustfs-access-key
S3_SECRET_KEY=replace-with-a-rustfs-secret
S3_BUCKET=docs
SESSION_SECRET=replace-with-a-random-password-pepper
CASUAL_JWT_SECRET=replace-with-at-least-16-random-characters

PUBLIC_APP_URL=https://docs.example.com
PUBLIC_API_URL=https://docs.example.com
FRONTEND_ORIGIN=https://docs.example.com
OFFICE_COLLAB_ENABLED=true
OFFICE_COLLAB_PUBLIC_URL=wss://docs.example.com:8444/yjs
CASUAL_SHEETS_EDITOR_URL=https://docs.example.com:8444
CASUAL_DOCS_EDITOR_URL=https://docs.example.com:8445
CASUAL_SHEETS_INTERNAL_WS_URL=ws://office-collab:3000/yjs
CASUAL_DOCS_INTERNAL_WS_URL=ws://casual-docs:3000/yjs

# Use absolute host paths. The certificate must cover the app and both editor URLs.
TLS_CERT_FILE=/etc/letsencrypt/live/docs.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/docs.example.com/privkey.pem
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CASUAL_SHEETS_HTTPS_PORT=8444
CASUAL_DOCS_HTTPS_PORT=8445
MAX_UPLOAD_BYTES=52428800

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://docs.example.com/api/auth/oidc/callback
OIDC_SCOPES=openid,email,profile
OIDC_AUTO_MERGE_BY_EMAIL=false

# Pin the same tested storage release in development and production.
RUSTFS_IMAGE=docker.io/rustfs/rustfs:1.0.0
