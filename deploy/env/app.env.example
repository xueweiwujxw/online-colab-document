APP_ENV=development
# Images are built and pushed by CI/release tooling. Production Compose never builds.
BACKEND_IMAGE=registry.example.com/online-colab-document/backend:VERSION
FRONTEND_IMAGE=registry.example.com/online-colab-document/frontend:VERSION
CASUAL_SHEETS_IMAGE=registry.example.com/online-colab-document/casual-sheets:VERSION
CASUAL_DOCS_IMAGE=registry.example.com/online-colab-document/casual-docs:VERSION
HTTP_ADDR=:8080
DATABASE_URL=postgres://docs:docs@postgres:5432/docs?sslmode=disable
POSTGRES_DB=docs
POSTGRES_USER=docs
POSTGRES_PASSWORD=change-me
REDIS_ADDR=redis:6379
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=docs
S3_USE_SSL=false
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=docs_session
SESSION_TTL_HOURS=168
SESSION_SECRET=change-me
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://mock-oidc:8080/realms/docs-collab
OIDC_CLIENT_ID=docs-collab
OIDC_CLIENT_SECRET=docs-collab-secret
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
OIDC_SCOPES=openid,email,profile
OIDC_AUTO_MERGE_BY_EMAIL=false
MAX_UPLOAD_BYTES=52428800
OFFICE_COLLAB_ENABLED=true
OFFICE_COLLAB_PUBLIC_URL=ws://localhost:1234
# At least 16 random characters. Set this only in an ignored local .env / secret store.
CASUAL_JWT_SECRET=replace-with-a-random-development-secret
CASUAL_DOCS_EDITOR_URL=http://localhost:1235
CASUAL_SHEETS_EDITOR_URL=http://localhost:1234
CASUAL_DOCS_INTERNAL_WS_URL=ws://casual-docs:3000/yjs
CASUAL_SHEETS_INTERNAL_WS_URL=ws://office-collab:3000/yjs
CASUAL_DOCS_HTTP_PORT=1235
CASUAL_SHEETS_HTTP_PORT=1234
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://backend:8080
MARKDOWN_SNAPSHOT_UPDATE_INTERVAL=100
NGINX_HTTP_PORT=8088
